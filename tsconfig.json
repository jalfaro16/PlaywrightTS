{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, 
    "paths": {
      "@fixtures/*": ["./tests/src/fixtures/*"],
      "@pages/*": ["./tests/src/pages/*"],
      "@test-data/*": ["./test-data/*"],
      "tests/*": ["./tests/*"]
    },
    "types": ["node", "playwright/test"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
