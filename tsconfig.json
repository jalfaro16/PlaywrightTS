{"compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "resolveJsonModule": true, 
    "paths": {
      "@fixtures/*": ["tests/src/fixtures/*"],
      "@pages/*": ["tests/src/pages/*"],
      "@test-data/*": ["test-data/*"]
    },
    "types": ["node", "playwright/test"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]}